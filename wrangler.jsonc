{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newton-prime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": { "STOCKITY_API_BASE": "https://api.stockity1.id" }
}
